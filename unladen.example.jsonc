{
  // Copied to config/config.jsonc, which compose mounts read-only at
  // /config/unladen/config.jsonc. `chmod 0644` it, or the container's uid 65532
  // cannot read it. The image passes --host/--port, so a `listen` here would be
  // overridden.
  // At least 16 characters; the gateway refuses a shorter one.
  "panel": { "token": "replace-with-a-panel-token" },
  "accounts": {
    "anthropic": "replace-with-an-anthropic-key",
    "deepseek": { "key": "replace-with-a-deepseek-key" }
  },
  "models": {
    "claude-*": "anthropic",
    "*": "deepseek/deepseek-chat"
  },
  "clients": {
    "laptop": { "key": "replace-with-a-client-key", "models": "*" }
  }
}
